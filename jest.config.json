{
  "collectCoverageFrom": [
    "src/**/*.ts"
  ],
  "moduleFileExtensions": [
    "ts",
    "js"
  ],
  "preset": "ts-jest",
  "roots": [
    "<rootDir>"
  ],
  "setupFilesAfterEnv": [
    "jest-extended/all"
  ],
  "testEnvironment": "node",
  "testPathIgnorePatterns": [
    "/node_modules/",
    "/dist/",
    "/test/helpers/"
  ]
}
